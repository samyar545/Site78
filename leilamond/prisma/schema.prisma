// ============================================================================
// Leilamond (لیلاموند) — Database Schema
// PostgreSQL + Prisma
//
// این فایل معماری کامل دیتابیس فروشگاه است. مدل‌ها به گروه‌های منطقی
// دسته‌بندی شده‌اند تا نگهداری و توسعه آن ساده بماند.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. AUTH / USERS / RBAC
// ----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]
  cart            Cart?
  favorites       Favorite[]
  reviews         Review[]
  sessions        Session[]
  beautyProfile   BeautyProfile?
  aiRequests      AIRequest[]
  tickets         SupportTicket[]      @relation("TicketRequester")
  assignedTickets SupportTicket[]      @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  stockAlerts     StockAlert[]
  priceAlerts     PriceDropAlert[]
  recentlyViewed  RecentlyViewed[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. SUPER_ADMIN, ADMIN, EDITOR, ORDER_MANAGER, PRODUCT_MANAGER, SUPPORT_AGENT, CUSTOMER
  name        String
  description String?
  isSystem    Boolean      @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. products.create, orders.update, support.reply
  group String // e.g. products, orders, support, settings
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  province   String
  city       String
  postalCode String
  addressLine String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]

  @@index([userId])
}

// ----------------------------------------------------------------------------
// 2. CATALOG: BRANDS / CATEGORIES / PRODUCTS
// ----------------------------------------------------------------------------

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  imageUrl      String?
  icon          String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  metaTitle     String?
  metaDesc      String?
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@index([slug])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  shortDescription String?
  description      String?   // rich text, sanitized before render
  sku              String?   @unique
  basePrice        Int       // stored as integer (smallest currency unit — تومان)
  compareAtPrice   Int?      // original price shown as struck-through
  stock            Int       @default(0)
  weightGrams      Int?
  color            String?
  attributes       Json?     // flexible spec bag: { skinType: "oily", ... }
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean   @default(false)
  isNew            Boolean   @default(false)
  isBestSellerOverride Boolean? // admin override; null = auto-computed
  ratingAvg        Float     @default(0)
  ratingCount      Int       @default(0)
  salesCount       Int       @default(0)
  publishedAt      DateTime?
  metaTitle        String?
  metaDesc         String?
  canonicalUrl     String?
  ogImageUrl       String?

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  sectionLinks HomepageSectionProduct[]
  discountLinks DiscountProduct[]
  campaignLinks CampaignProduct[]
  stockAlerts  StockAlert[]
  priceAlerts  PriceDropAlert[]
  recentlyViewedBy RecentlyViewed[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([isNew])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Red", "Nude"
  sku       String?  @unique
  price     Int?     // overrides product basePrice when set
  stock     Int      @default(0)
  imageUrl  String?
  isActive  Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ----------------------------------------------------------------------------
// 3. CART / ORDERS / PAYMENTS
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // e.g. LEI-100234
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  status         OrderStatus @default(PENDING)

  subtotal       Int         // sum of item prices before discounts
  discountTotal  Int         @default(0)
  shippingCost   Int         @default(0)
  total          Int         // final payable amount

  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])

  items          OrderItem[]
  payments       Payment[]

  customerNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String          // snapshot at purchase time
  unitPrice   Int             // snapshot at purchase time
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}

enum PaymentStatus {
  INITIATED
  PENDING_CALLBACK
  VERIFIED
  FAILED
  REFUNDED
}

// یک رکورد Payment برای هر تلاش پرداخت روی یک سفارش.
// Provider واقعی (زرین‌پال / آیدی‌پی / نکست‌پی و ...) پشت اینترفیس PaymentProvider قرار می‌گیرد.
model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  provider        String        // e.g. "zarinpal", "idpay", "mock"
  amount          Int
  status          PaymentStatus @default(INITIATED)
  authority       String?       @unique // provider transaction/authority id
  refId           String?       // provider reference id after verification
  gatewayResponse Json?
  idempotencyKey  String        @unique // prevents double-processing of the same callback
  createdAt       DateTime      @default(now())
  verifiedAt      DateTime?

  @@index([orderId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// 4. DISCOUNTS / COUPONS / CAMPAIGNS
// ----------------------------------------------------------------------------

model Discount {
  id            String    @id @default(cuid())
  name          String
  percent       Int?
  fixedPrice    Int?
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean   @default(true)
  products      DiscountProduct[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DiscountProduct {
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  percent         Int?
  fixedAmount     Int?
  minPurchase     Int?
  maxDiscount     Int?
  usageLimit      Int?
  usageCount      Int        @default(0)
  startAt         DateTime?
  endAt           DateTime?
  isActive        Boolean    @default(true)
  orders          Order[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// کمپین‌های «تخفیف ویژه با Countdown» — چند کمپین مستقل، هرکدام با محصولات و بازهٔ زمانی خودشان
model DiscountCampaign {
  id          String            @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  percent     Int?
  fixedPrice  Int?
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean           @default(true)
  products    CampaignProduct[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startAt, endAt])
}

model CampaignProduct {
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

// ----------------------------------------------------------------------------
// 5. HOMEPAGE BUILDER / BANNERS / ADVERTISEMENTS
// ----------------------------------------------------------------------------

enum SectionType {
  HERO_BANNER
  PRODUCT_GRID
  PRODUCT_CAROUSEL
  CATEGORY_GRID
  DISCOUNT_PRODUCTS
  NEW_PRODUCTS
  BEST_SELLERS
  ADVERTISEMENT
  CUSTOM_BANNER
  TEXT_SECTION
  BRAND_SECTION
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model HomepageSection {
  id           String        @id @default(cuid())
  type         SectionType
  title        String?
  description  String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  status       ContentStatus @default(DRAFT)
  productLimit Int?
  categoryId   String?
  imageUrl     String?
  linkUrl      String?
  backgroundColor String?
  visibleFrom  DateTime?
  visibleUntil DateTime?
  devices      String[]      @default(["mobile", "tablet", "desktop"])
  products     HomepageSectionProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sortOrder])
  @@index([isActive, status])
}

model HomepageSectionProduct {
  sectionId String
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)

  @@id([sectionId, productId])
}

model Banner {
  id            String        @id @default(cuid())
  title         String
  imageUrlDesktop String
  imageUrlMobile  String?
  linkUrl       String?
  buttonText    String?
  position      String        // e.g. HOME_TOP, HOME_HERO ...
  priority      Int           @default(0)
  status        ContentStatus @default(DRAFT)
  startAt       DateTime?
  endAt         DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([position, priority])
}

enum AdType {
  IMAGE
  BANNER
  SIDE
}

// موقعیت‌های تبلیغ به صورت رشته‌ی آزاد نگه داشته شده تا ادمین بتواند
// بعداً موقعیت‌های جدید تعریف کند بدون نیاز به Migration.
model Advertisement {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  linkUrl     String?
  title       String?
  description String?
  ctaText     String?
  type        AdType   @default(IMAGE)
  position    String   // e.g. HOME_TOP, HOME_HERO, HOME_RIGHT, HOME_LEFT, HOME_BETWEEN_PRODUCTS, HOME_BOTTOM
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position, priority])
  @@index([startAt, endAt])
}

// ----------------------------------------------------------------------------
// 6. CONTENT: PAGES / MENUS / SETTINGS / MEDIA
// ----------------------------------------------------------------------------

model Page {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  content   String        // sanitized HTML/rich text
  status    ContentStatus @default(DRAFT)
  metaTitle String?
  metaDesc  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Menu {
  id    String     @id @default(cuid())
  key   String     @unique // e.g. "header", "footer"
  items MenuItem[]
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label     String
  url       String
  parentId  String?
  parent    MenuItem? @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  sortOrder Int      @default(0)

  @@index([menuId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "general.siteName", "payment.provider", "ai.provider"
  value     Json
  updatedAt DateTime @updatedAt
}

model Media {
  id         String   @id @default(cuid())
  fileName   String
  url        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 7. REVIEWS / WISHLIST / ALERTS / RECENTLY VIEWED
// ----------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                String       @id @default(cuid())
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  rating            Int
  comment           String?
  images            String[]     @default([])
  isVerifiedPurchase Boolean     @default(false)
  status            ReviewStatus @default(PENDING)
  adminReply        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PriceDropAlert {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAtAlert Int
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([userId, productId])
}

model RecentlyViewed {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@id([userId, productId])
}

// ----------------------------------------------------------------------------
// 8. AI BEAUTY
// ----------------------------------------------------------------------------

model BeautyProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinType       String?
  favoriteColors String[] @default([])
  preferredCategories String[] @default([])
  makeupStyle    String?
  updatedAt      DateTime @updatedAt
}

enum AIRequestType {
  VIRTUAL_TRY_ON
  FACE_ANALYSIS
  PRODUCT_RECOMMENDATION
}

enum AIRequestStatus {
  PENDING
  SUCCESS
  FAILED
}

// لاگ هر درخواست AI — برای Rate limiting، Debug و تحلیل مصرف
model AIRequest {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  type      AIRequestType
  provider  String          // e.g. "mock", "external-vendor-x"
  status    AIRequestStatus @default(PENDING)
  inputMeta Json?           // no raw biometric images stored — only metadata/refs
  outputMeta Json?
  errorMessage String?
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([type])
}

// ----------------------------------------------------------------------------
// 9. SUPPORT / TICKETS
// ----------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  WAITING_FOR_SUPPORT
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique // e.g. LEI-10482
  userId       String
  user         User           @relation("TicketRequester", fields: [userId], references: [id])
  subject      String
  topic        String?
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  assigneeId   String?
  assignee     User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages     TicketMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  body       String
  attachments String[]     @default([])
  isFromStaff Boolean      @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// ----------------------------------------------------------------------------
// 10. NOTIFICATIONS / AUDIT LOG
// ----------------------------------------------------------------------------

enum NotificationType {
  ORDER
  PAYMENT
  TICKET
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ثبت اقدامات حساس ادمین‌ها — قیمت، سفارش، دسترسی و ...
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String   // e.g. "product.price.update"
  entityType String   // e.g. "Product"
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
