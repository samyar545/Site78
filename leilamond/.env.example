# ============================================================
# Leilamond — Environment Variables
# این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را در Git کامیت نکنید.
# ============================================================

# Database
DATABASE_URL="postgresql://leilamond:leilamond@localhost:5432/leilamond?schema=public"

# Auth
AUTH_SECRET="یک-رشته-تصادفی-طولانی-و-امن-اینجا-قرار-دهید"
NODE_ENV="development"

# Payment (درگاه بانکی واقعی — مثلاً زرین‌پال)
PAYMENT_PROVIDER="mock"          # mock | zarinpal | idpay | nextpay
PAYMENT_MERCHANT_ID=""
PAYMENT_API_KEY=""

# AI Beauty
AI_ENABLED="false"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_DAILY_REQUEST_LIMIT="100"

# Storage (S3-compatible — برای تصاویر محصولات/بنرها)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Notifications (SMS/Email — اختیاری)
SMS_ENABLED="false"
SMS_API_KEY=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
